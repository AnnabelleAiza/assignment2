                           </HBox.margin>
                        </Button>
                        <Button fx:id="pauseBtn" mnemonicParsing="false" prefWidth="60.0" text="Pause">
                           <HBox.margin>
                              <Insets right="20.0" top="15.0" />
                           </HBox.margin>
                        </Button>
                        <Button fx:id="resetBtn" mnemonicParsing="false" prefWidth="60.0" text="Reset">
